# Supabase Connection & Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Postgres Database URLs (Prisma)
# Direct connection string for migrations/schema push:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgboiler=true"
# Connection pooler URL (for serverless runtime):
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Z-AI SDK — required for real AI voice/photo parsing + template drafting.
ZAI_API_KEY=""
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"

# Optional Messaging Transports:
# WHATSAPP_CLOUD_API_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# RESEND_API_KEY=""
