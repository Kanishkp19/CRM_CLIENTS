// Cycle — Universal Membership & Lifecycle CRM
// Production Hardened Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A business (one per owner in v1). Vertical-agnostic.
model Business {
  id                 String   @id @default(cuid())
  ownerUserId        String   @default("00000000-0000-0000-0000-000000000000") @map("owner_user_id")
  ownerName          String   @map("owner_name")
  name               String
  verticalType       String   @map("vertical_type")
  entityLabel        String   @map("entity_label")
  cycleType          String   @default("date_based") @map("cycle_type")
  customFieldSchema  Json     @default("[]") @map("custom_field_schema")
  reminderConfig     Json     @default("{}") @map("reminder_config")
  messageTemplates   Json     @default("{}") @map("message_templates")
  tier               String   @default("free")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  entities Entity[]

  @@map("businesses")
}

/// A client / member / pet / asset — same model for every vertical.
model Entity {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  name          String
  phone         String
  email         String?
  customFields  Json     @default("{}") @map("custom_fields")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cycles        Cycle[]
  notifications NotificationLog[]

  @@map("entities")
}

/// A time-bound or count-bound lifecycle unit attached to an entity.
model Cycle {
  id              String   @id @default(cuid())
  entityId        String   @map("entity_id")
  planName        String   @map("plan_name")
  startDate       DateTime @map("start_date")
  endDate         DateTime? @map("end_date")
  unitsTotal      Int?     @map("units_total")
  unitsRemaining Int?      @map("units_remaining")
  status          String   @default("active")
  amount          Decimal? @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  entity          Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  notifications    NotificationLog[]

  @@map("cycles")
}

/// Audit log of every outbound WhatsApp / email notification with atomic deduplication.
model NotificationLog {
  id           String   @id @default(cuid())
  entityId     String   @map("entity_id")
  cycleId      String?  @map("cycle_id")
  dedupKey     String?  @unique @map("dedup_key")
  channel      String
  triggerType  String   @map("trigger_type")
  message      String
  sentAt       DateTime @default(now()) @map("sent_at")
  status       String   @default("sent")

  entity       Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  cycle        Cycle?   @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@map("notifications_log")
}
